# ---------------------------------------------------------------------------
# 复制为 .env 后按需修改；所有变量都带默认值，开发环境可直接运行
# ---------------------------------------------------------------------------

# 数据库：本机 app_user 只有 mock_prod_db 的权限，因此所有表统一使用 wf_ 前缀，
# 将来拿到独立库（如 wild_fishing）时，只需改这一行并执行 alembic upgrade head。
DATABASE_URL=mysql+pymysql://app_user:app_password_123@127.0.0.1:3306/mock_prod_db?charset=utf8mb4

# JWT 签名密钥：生产环境务必替换成随机长字符串（openssl rand -hex 32）
SECRET_KEY=dev-only-secret-please-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 允许跨域的前端地址（开发时 Vite 默认 5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 定位失败时的兜底城市（城市名需存在于 wf_city）
DEFAULT_CITY=杭州

# 静态资源对外前缀（用于拼接封面图地址）
PUBLIC_BASE_URL=http://localhost:8000
